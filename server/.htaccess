# برخی هاست‌ها (CGI/FastCGI) هدر Authorization را به PHP نمی‌رسانند؛ این خط آن را منتقل می‌کند.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
CGIPassAuth On

# جلوگیری از دسترسی مستقیم به فایل تنظیمات و migration
<FilesMatch "^(config\.php|config\.example\.php|migration\.sql)$">
    Require all denied
</FilesMatch>
